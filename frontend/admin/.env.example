# Local development template only.
# Do not put real production secrets here.
# CI/CD uses GitLab variables and writes a temporary .env during deploy.

# application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
ADMIN_BIND_HOST=127.0.0.1
ADMIN_HOST_PORT=3910
ADMIN_IMAGE_NAME=admin-panel:latest
ADMIN_CONTAINER_NAME=admin-panel
SECRET_KEY=dev-only-change-me-generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOW_ORIGINS=http://localhost:3910,http://127.0.0.1:3910
ALGORITHM=HS256

# database (asyncpg driver)
POSTGRES_DB=telegram_access
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ADMIN_DB_BIND_HOST=127.0.0.1
ADMIN_DB_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/telegram_access

# local admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev-admin-password
ADMIN_TELEGRAM_ID=-1
ADMIN_COOKIE_SECURE=false

# GitLab CI/CD variable names for deployed environments:
# ADMIN_DATABASE_URL / ADMIN_DATABASE_URL_TEST
# ADMIN_SECRET_KEY / ADMIN_SECRET_KEY_TEST
# ADMIN_USERNAME / ADMIN_USERNAME_TEST
# ADMIN_PASSWORD / ADMIN_PASSWORD_TEST
# ADMIN_TELEGRAM_ID / ADMIN_TELEGRAM_ID_TEST

# LightRAG admin builds.
# The admin container must be able to run these commands. In production, either
# mount the repo at LIGHTRAG_REPO_DIR or point the commands at a separate runner.
LIGHTRAG_REPO_MOUNT=../..
LIGHTRAG_REPO_DIR=/workspace/distributed-agent
LIGHTRAG_WORK_DIR=python/RAG/out/lightrag
LIGHTRAG_BUILD_FULL_COMMAND=make lightrag LIGHTRAG_RESET=1 LIGHTRAG_INDEX_ONLY=1
LIGHTRAG_BUILD_CONTINUE_COMMAND=make lightrag LIGHTRAG_REBUILD=1 LIGHTRAG_INDEX_ONLY=1
LIGHTRAG_UPLOAD_ENABLED=true
LIGHTRAG_S3_PREFIX=lightrag

# LightRAG artifact upload uses the same vectors bucket, under LIGHTRAG_S3_PREFIX.
S3_ENDPOINT=
S3_BUCKET_VECTORS=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=false
S3_VERIFY=false
